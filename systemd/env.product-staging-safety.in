DJANGO_DEBUG=0
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
TEMPLEDB_DEMO_MODE=0
TEMPLEDB_ALLOW_POSTGRESQL_DEMO=0
TEMPLEDB_DATABASE_ENGINE=postgresql
TEMPLEDB_SQLITE_DB_PATH=
TEMPLEDB_RUNTIME_ROLE=staging
TEMPLEDB_TENANT_ROOT=@TENANT_ROOT@
MPLCONFIGDIR=@TENANT_ROOT@/data/runtime/matplotlib
XDG_CACHE_HOME=@TENANT_ROOT@/data/runtime/xdg-cache
TEMPLEDB_GUNICORN_UPSTREAM=127.0.0.1:@PRODUCT_STAGING_GUNICORN_PORT@
TEMPLEDB_TAILSCALE_SERVE=0
TEMPLEDB_TRUSTED_PROXY_HTTPS=1
TEMPLEDB_LEGACY_REIMPORT_ENABLED=0
TEMPLEDB_BACKUP_DESTINATION_PATH=@PRODUCT_STAGING_BACKUP_ROOT@
TEMPLEDB_EXTERNAL_BASE_URL=
TEMPLEDB_GOOGLE_SERVICE_ACCOUNT_FILE=
TEMPLEDB_STAGING_ALLOW_OPENAI=@PRODUCT_STAGING_ALLOW_OPENAI@
DATABASE_HOST=127.0.0.1
DATABASE_NAME=@PRODUCT_STAGING_DATABASE_NAME@
DATABASE_USER=@PRODUCT_STAGING_DATABASE_USER@
DATABASE_PORT=@PRODUCT_STAGING_DATABASE_PORT@
